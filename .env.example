# ==============================================================================
# FCIM AI Chatbot Configuration
# ==============================================================================

# Environment
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# ==============================================================================
# LLM Configuration (Qwen2.5-3B)
# ==============================================================================
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_HOST=http://localhost
LLM_PORT=8001
LLM_API_BASE=http://localhost:8001/v1
LLM_MAX_TOKENS=50
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_MAX_MODEL_LEN=4096
LLM_GPU_MEMORY_UTILIZATION=0.80
LLM_TENSOR_PARALLEL_SIZE=1
LLM_DTYPE=auto  # auto, half (FP16) or bfloat16

# ==============================================================================
# Embedding Model Configuration
# ==============================================================================
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cuda  # cuda or cpu

# ==============================================================================
# Vector Database (Qdrant)
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=fcim_courses
QDRANT_DISTANCE_METRIC=Cosine
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_HNSW_EF=128
QDRANT_API_KEY=  # Optional, leave empty for local

# ==============================================================================
# Redis Cache
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Optional
REDIS_MAX_CONNECTIONS=50
REDIS_TTL=604800  # 7 days in seconds
REDIS_MAX_MEMORY=2GB
REDIS_EVICTION_POLICY=allkeys-lru

# ==============================================================================
# RAG Configuration
# ==============================================================================
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_CONTEXT_LENGTH=4000
RAG_RERANK=false  # Enable re-ranking of retrieved chunks

# ==============================================================================
# FastAPI Application
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
API_TITLE="FCIM AI Assistant API"
API_VERSION=1.0.0
API_DOCS_URL=/docs
API_OPENAPI_URL=/openapi.json

# ==============================================================================
# Security & Authentication
# ==============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://else.fcim.utm.md,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# ==============================================================================
# Monitoring
# ==============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
METRICS_ENABLED=true

# ==============================================================================
# Data Pipeline
# ==============================================================================
DATA_RAW_PATH=/app/data/raw
DATA_PROCESSED_PATH=/app/data/processed
DATA_EMBEDDINGS_PATH=/app/data/embeddings
BATCH_SIZE_EMBEDDING=32
BATCH_SIZE_UPLOAD=100

# ==============================================================================
# Moodle Integration
# ==============================================================================
MOODLE_URL=https://else.fcim.utm.md
MOODLE_API_TOKEN=your-moodle-webservice-token
MOODLE_SERVICE_NAME=fcim_ai_assistant

# ==============================================================================
# Logging
# ==============================================================================
LOG_FORMAT=json  # json or text
LOG_FILE_PATH=/app/logs/app.log
LOG_ROTATION_SIZE=100MB
LOG_RETENTION_DAYS=30

# ==============================================================================
# Performance Tuning
# ==============================================================================
MAX_REQUEST_SIZE=10MB
REQUEST_TIMEOUT=60
MAX_CONCURRENT_REQUESTS=50
CACHE_HIT_TARGET=0.30
